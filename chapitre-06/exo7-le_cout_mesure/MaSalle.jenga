from Jenga import *

useconfig("../R3D/R3D.jenga")

with workspace("MaSalle", location="."):
    configurations(["Debug", "Release"])

    with project("MaSalle"):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")
        files(["cout.cpp"])
        includedirs(["../R3D/include"])
        user3d()
        ldflags(["-Wl,--allow-multiple-definition"])
        with filter("config:Release"):
            optimize("Speed")
